# Daily Paper Reader · 复制为 .env。日报密钥填在此处，非敏感参数优先读取 config.yaml 的 pipeline 块。
# 标为可选的空项可保持注释。已有进程环境变量优先于本文件。

# Daily
# [必填] 标准日报必填，供评分和分诊共用。 线上：Secret。
DEEPSEEK_API_KEY=
# [可选] YAML 未设置模型时使用的兼容值。 线上：日报 Secret / 精读可用 Variable。
# DEEPSEEK_MODEL=deepseek-flash
# [可选] 日报可用 Secret 改端点；精读优先读取同名 Variable。 线上：日报 Secret / 精读可用 Variable。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# [可选] 新速览语言，可填 zh 或 en。 线上：Variable。
SUMMARY_LANG=zh
# [可选] 分诊专用密钥，默认复用日报密钥。 线上：Secret。
# TRIAGE_API_KEY=
# [可选] 分诊模型 ID，默认复用日报模型。 线上：Variable。
# TRIAGE_MODEL=
# [可选] 分诊服务地址，默认复用日报端点。 线上：Variable。
# TRIAGE_BASE_URL=
# [可选] 旧版摘要使用的密钥，默认复用日报密钥。 线上：Secret。
# SUMMARY_API_KEY=
# [可选] 旧版摘要服务地址，默认复用日报端点。 线上：Secret。
# SUMMARY_BASE_URL=
# [可选] 旧版摘要模型，默认复用日报模型。 线上：Secret。
# SUMMARY_MODEL=
# [可选] 历史兼容项，默认留空；摘要步骤会按解析后的端点设置它。 线上：Secret。
# LLM_PRIMARY_BASE_URL=

# Retrieval
# [可选] 向量服务端点，默认 https://zwwen.online/embed。 线上：Secret。
# DPR_EMBED_API_URL=
# [可选] 向量服务凭据，可替换公共客户端默认配置。 线上：Secret。
# DPR_EMBED_API_KEY=
# [可选] 重排预设，手动运行时的输入优先于 Secret。 线上：Secret。
RERANK_PROFILE=public-zwwen-rerank
# [可选] 选择重排服务商，默认跟随预设。 线上：Secret。
# RERANK_PROVIDER=
# [可选] 重排模型 ID，默认跟随预设。 线上：Secret。
# RERANK_MODEL=
# [可选] 重排服务地址，默认跟随预设。 线上：Secret。
# RERANK_API_BASE_URL=
# [可选] 重排服务凭据，按所选服务填写。 线上：Secret。
# RERANK_API_KEY=
# [可选] 公共重排端点，默认 https://zwwen.online/rerank。 线上：Secret。
# PUBLIC_RERANK_API_BASE_URL=
# [可选] 公共重排密钥，可替换客户端默认配置。 线上：Secret。
# PUBLIC_RERANK_API_KEY=
# [可选] 仅 SiliconFlow 重排需要，默认端点 https://api.siliconflow.cn/v1/rerank，使用时提供服务商密钥。 线上：Secret。
# SILICONFLOW_RERANK_URL=
# [可选] 仅 SiliconFlow 重排需要，默认端点 https://api.siliconflow.cn/v1/rerank，使用时提供服务商密钥。 线上：Secret。
# SILICONFLOW_API_KEY=
# [可选] SiliconFlow 请求最小间隔，Actions 默认 8 秒。 线上：Secret。
# SILICONFLOW_RERANK_MIN_INTERVAL_SECONDS=8

# Personal state
# [可选] 反馈调权所用的个人阅读状态库 URL。 线上：Secret。
# DPR_STATE_SUPABASE_URL=
# [可选] 读取个人反馈所需的服务端密钥。 线上：Secret。
# DPR_STATE_SERVICE_KEY=
# [可选] 提供正负反馈的 Supabase Auth 用户 UUID。 线上：Secret。
# DPR_FEEDBACK_USER_ID=
# [可选] 飞书日报 webhook，留空不推送。 线上：Secret。
# DPR_NOTIFY_FEISHU_WEBHOOK=

# Catalog maintenance
# [可选] 论文检索库地址，默认取 YAML。 线上：Secret。
# SUPABASE_URL=
# [可选] 论文检索库的只读公钥，默认取 YAML。 线上：Secret。
# SUPABASE_ANON_KEY=
# [可选，启用时必填] 仅维护论文库时需要目标库的服务端密钥。维护工作流限定目标项目及可运行仓库。 线上：Secret。
# SUPABASE_SERVICE_KEY=
# [可选] 会议抓取使用的 OpenReview 用户名。 线上：Secret。
# OPENREVIEW_USERNAME=
# [可选] 会议抓取使用的 OpenReview 密码。 线上：Secret。
# OPENREVIEW_PASSWORD=

# Deep read
# [可选] 精读专用密钥，同端点可复用日报密钥；换服务商需提供对应密钥。 线上：Secret。
# DEEP_READ_API_KEY=
# [可选] 精读模型、端点，Variable 优先于 Secret。留空沿用日报配置，官方端点缺模型时选 deepseek-flash，自定义端点必须配置模型。 线上：Variable / Secret。
# DEEP_READ_MODEL=
# [可选] 精读模型、端点，Variable 优先于 Secret。留空沿用日报配置，官方端点缺模型时选 deepseek-flash，自定义端点必须配置模型。 线上：Variable / Secret。
# DEEP_READ_BASE_URL=
# [可选] 私有笔记仓库（owner/repo），留空跳过精读任务的云端同步。 线上：Variable。
# OBSIDIAN_NOTES_REPO=
# [可选] 独立笔记仓库的目标分支。 线上：Variable。
# OBSIDIAN_NOTES_BRANCH=main
# [可选] 独立笔记仓库的收件箱目录。 线上：Variable。
# OBSIDIAN_NOTES_FOLDER=Inbox
# [可选，启用时必填] 仅云端同步精读笔记时需要，授权目标笔记仓库 Contents 写权限。 线上：Secret。
# OBSIDIAN_NOTES_TOKEN=

# Local overrides · 更换论文源也可编辑 config.yaml 的 source_backends。
# [可选] 私有订阅配置路径，默认仓库根目录 config.yaml。 线上：无对应 Secrets / Variables。
# DPR_CONFIG_FILE=
# [可选] 固定本次运行标识，便于复现同一批次。 线上：无对应 Secrets / Variables。
# DPR_RUN_DATE=
# [可选] 分诊缓存目录；本地可指向工作区运行目录。 线上：无对应 Secrets / Variables。
# DPR_TRIAGE_CACHE_DIR=
# [可选] 旧分诊脚本的运行报告路径。 线上：无对应 Secrets / Variables。
# DPR_TRIAGE_REPORT=
# [可选] 仅使用远程向量与重排服务，与 Actions 一致。 线上：无对应 Secrets / Variables。
DPR_MODELS_REMOTE_ONLY=1
# [可选] 允许已安装本地模型依赖时回退到本地向量服务。 线上：无对应 Secrets / Variables。
# DPR_EMBED_ALLOW_LOCAL_FALLBACK=0
# [可选] 仅本地重排预设使用的模型。 线上：无对应 Secrets / Variables。
# LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# [可选] 论文库维护所用 schema。 线上：无对应 Secrets / Variables。
# SUPABASE_SCHEMA=public
# [可选] 维护脚本的数据源。 线上：无对应 Secrets / Variables。
# SUPABASE_BACKEND_KEY=arxiv
# [可选] 覆盖 arXiv 论文表。 线上：无对应 Secrets / Variables。
# SUPABASE_PAPERS_TABLE=arxiv_papers
# [可选] 覆盖关键词召回函数。 线上：无对应 Secrets / Variables。
# SUPABASE_BM25_RPC=match_arxiv_papers_bm25
# [可选] 覆盖向量召回函数。 线上：无对应 Secrets / Variables。
# SUPABASE_VECTOR_RPC=match_arxiv_papers
# [可选] 覆盖精确向量召回函数。 线上：无对应 Secrets / Variables。
# SUPABASE_VECTOR_RPC_EXACT=match_arxiv_papers_exact
# [可选] 覆盖同步进度表。 线上：无对应 Secrets / Variables。
# SUPABASE_SYNC_TABLE=arxiv_sync_status
# [可选] 启用 arXiv 后端。 线上：无对应 Secrets / Variables。
# DPR_ARXIV_ENABLED=1
# [可选] 使用 arXiv 关键词检索 RPC。 线上：无对应 Secrets / Variables。
# DPR_ARXIV_USE_BM25_RPC=1
# [可选] 使用 arXiv 向量检索 RPC。 线上：无对应 Secrets / Variables。
# DPR_ARXIV_USE_VECTOR_RPC=1
# [可选] 启用 bioRxiv 后端覆盖。 线上：无对应 Secrets / Variables。
# DPR_ENABLE_BIORXIV_BACKEND=1
# [可选] 覆盖 bioRxiv 后端地址。 线上：无对应 Secrets / Variables。
# DPR_BIORXIV_URL=
# [可选] 覆盖 bioRxiv 只读公钥。 线上：无对应 Secrets / Variables。
# DPR_BIORXIV_ANON_KEY=
# [可选] 覆盖 bioRxiv 论文表。 线上：无对应 Secrets / Variables。
# DPR_BIORXIV_PAPERS_TABLE=biorxiv_papers
# [可选] 覆盖 bioRxiv 关键词检索函数。 线上：无对应 Secrets / Variables。
# DPR_BIORXIV_BM25_RPC=match_biorxiv_papers_bm25
# [可选] 覆盖 bioRxiv 向量检索函数。 线上：无对应 Secrets / Variables。
# DPR_BIORXIV_VECTOR_RPC=match_biorxiv_papers_exact
# [可选] 禁用加载 .env，启动前在 shell 中设置。 线上：无对应 Secrets / Variables。
# DPR_DISABLE_DOTENV=1
# [可选] 选择其他环境文件，例如 .env.local，启动前在 shell 中设置。 线上：无对应 Secrets / Variables。
# DPR_DOTENV_PATH=
