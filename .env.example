# Daily Paper Reader 本地调试环境变量模板
# 复制为 `.env` 后填写真实值；`.env` 已被 `.gitignore` 忽略，不会同步到 GitHub。

# ===== 基础运行 =====
# 可固定一次本地运行日期，便于复现 archive 路径；留空则使用当天 UTC 日期。
# DPR_RUN_DATE=20260521

# 如需临时使用另一份配置文件，可指向本地私有 YAML；留空则读取 `config.yaml`。
# DPR_CONFIG_FILE=config.local.yaml

# ===== LLM / 总结模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 兼容摘要链路的变量名；不填时多数脚本会回退到 DEEPSEEK_*。
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
SUMMARY_MODEL=
LLM_PRIMARY_BASE_URL=

# ===== 新版一级分诊 / 按需精读 =====
# 分诊留空会回退 DEEPSEEK_*；Actions 中 TRIAGE_MODEL / BASE_URL 使用 Variables。
TRIAGE_API_KEY=
TRIAGE_MODEL=
TRIAGE_BASE_URL=
# 精读优先使用专用配置；未配置专用 Key 时复用 DEEPSEEK_API_KEY。
# 官方 DeepSeek 可在论文页选择 Flash/Pro；其他服务需填写以下三项。
DEEP_READ_API_KEY=
DEEP_READ_MODEL=
DEEP_READ_BASE_URL=
# 可选运行报告路径，默认 cache-dir/latest-run.json；不要放入公开 docs/。
# DPR_TRIAGE_REPORT=

# ===== 新版反馈（可选，服务器端） =====
# 与论文召回库分开：这是保存 paper_states 的个人状态项目。
# USER_ID 是 Supabase Auth UUID，不是 GitHub 用户名；留空不启用反馈评分。
DPR_FEEDBACK_USER_ID=
DPR_STATE_SUPABASE_URL=
DPR_STATE_SERVICE_KEY=

# ===== Obsidian 私有笔记仓库（可选） =====
# 仓库/分支/目录在 Actions 使用 Variables，Token 使用 Secret。
OBSIDIAN_NOTES_REPO=
OBSIDIAN_NOTES_BRANCH=main
OBSIDIAN_NOTES_FOLDER=Inbox
OBSIDIAN_NOTES_TOKEN=
# 可选飞书通知 Secret；仅在已核验发布成功后发送。
DPR_NOTIFY_FEISHU_WEBHOOK=

# ===== Reranker =====
# public-zwwen-rerank / local-qwen3-0.6b / siliconflow-qwen3-0.6b
RERANK_PROFILE=public-zwwen-rerank
RERANK_PROVIDER=public_zwwen
LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_API_KEY=
RERANK_API_BASE_URL=https://zwwen.online/rerank
SILICONFLOW_API_KEY=
SILICONFLOW_RERANK_URL=

# 公益 embedding / rerank 服务；如需私有服务，可在本地 `.env` 覆盖。
DPR_EMBED_API_URL=https://zwwen.online/embed
DPR_EMBED_API_KEY=
# 默认不自动安装/加载本地 Torch 模型；仅当远程 embedding 不可用且已安装 requirements-local-models.txt 时再开启。
DPR_EMBED_ALLOW_LOCAL_FALLBACK=0
PUBLIC_RERANK_API_KEY=
PUBLIC_RERANK_API_BASE_URL=https://zwwen.online/rerank

# ===== Supabase 本地维护/同步 =====
# 只做只读召回时通常使用 config.yaml 内的 publishable/anon key 即可。
# 需要执行 maintain/sync.py 或 cleanup.py 时，在本地 `.env` 填 service key，千万不要提交。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_BACKEND_KEY=arxiv
SUPABASE_PAPERS_TABLE=arxiv_papers
SUPABASE_BM25_RPC=match_arxiv_papers_bm25
SUPABASE_VECTOR_RPC=match_arxiv_papers
SUPABASE_VECTOR_RPC_EXACT=match_arxiv_papers_exact
SUPABASE_SYNC_TABLE=arxiv_sync_status

# 控制本地 arXiv Supabase 召回开关；不填则沿用 config.yaml。
# DPR_ARXIV_ENABLED=1
# DPR_ARXIV_USE_BM25_RPC=1
# DPR_ARXIV_USE_VECTOR_RPC=1

# ===== 多源后端本地覆盖示例 =====
# 这些变量只会覆盖本地进程环境，不会写回 config.yaml。
# DPR_ENABLE_BIORXIV_BACKEND=1
# DPR_BIORXIV_URL=
# DPR_BIORXIV_ANON_KEY=
# DPR_BIORXIV_PAPERS_TABLE=biorxiv_papers
# DPR_BIORXIV_BM25_RPC=match_biorxiv_papers_bm25
# DPR_BIORXIV_VECTOR_RPC=match_biorxiv_papers_exact

# ===== OpenReview 抓取可选登录 =====
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# ===== 调试开关 =====
# 设为 1 可禁用自动加载 `.env`。
# DPR_DISABLE_DOTENV=1
# 指定其它 env 文件路径。
# DPR_DOTENV_PATH=/absolute/path/to/.env.local
