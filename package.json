{
  "name": "daily-paper-reader",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/package_reader.mjs",
    "test:reader": "node --experimental-strip-types --test reader/tests/*.test.ts",
    "test:reader:browser": "node scripts/check_reader_browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.89.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "@playwright/test": "1.57.0"
  }
}
